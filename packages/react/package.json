{
  "name": "@arcsyn/react",
  "version": "0.1.0",
  "description": "React adapter for the ArcSyn Design System.",
  "type": "module",
  "files": [
    "dist",
    "styles.css",
    "THIRD_PARTY_LICENSES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js"
    },
    "./sidebar": {
      "types": "./dist/components/sidebar/index.d.ts",
      "import": "./dist/components/sidebar/index.js"
    },
    "./data-table": {
      "types": "./dist/components/data-table/index.d.ts",
      "import": "./dist/components/data-table/index.js"
    },
    "./stat-card": {
      "types": "./dist/components/stat-card/index.d.ts",
      "import": "./dist/components/stat-card/index.js"
    },
    "./charts": {
      "types": "./dist/components/charts/index.d.ts",
      "import": "./dist/components/charts/index.js"
    },
    "./page-header": {
      "types": "./dist/components/page-header/index.d.ts",
      "import": "./dist/components/page-header/index.js"
    },
    "./search-input": {
      "types": "./dist/components/search-input/index.d.ts",
      "import": "./dist/components/search-input/index.js"
    },
    "./command": {
      "types": "./dist/components/command/index.d.ts",
      "import": "./dist/components/command/index.js"
    },
    "./status-indicator": {
      "types": "./dist/components/status-indicator/index.d.ts",
      "import": "./dist/components/status-indicator/index.js"
    },
    "./activity-feed": {
      "types": "./dist/components/activity-feed/index.d.ts",
      "import": "./dist/components/activity-feed/index.js"
    },
    "./user-menu": {
      "types": "./dist/components/user-menu/index.d.ts",
      "import": "./dist/components/user-menu/index.js"
    },
    "./data-state": {
      "types": "./dist/components/data-state/index.d.ts",
      "import": "./dist/components/data-state/index.js"
    },
    "./chat": {
      "types": "./dist/components/chat/index.d.ts",
      "import": "./dist/components/chat/index.js"
    },
    "./notification-center": {
      "types": "./dist/components/notification-center/index.d.ts",
      "import": "./dist/components/notification-center/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@arcsyn/styles": "workspace:*",
    "@arcsyn/tokens": "workspace:*",
    "@base-ui/react": "1.6.0",
    "lucide-react": "1.26.0",
    "sonner": "2.0.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.build.json --noEmit"
  }
}
