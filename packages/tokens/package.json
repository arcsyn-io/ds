{
  "name": "@arcsyn-io/tokens",
  "version": "0.1.0",
  "description": "Platform-agnostic design tokens for ArcSyn.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcsyn-io/ds.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "import": "./dist/js/index.js"
    },
    "./css": "./dist/css/tokens.css",
    "./themes/light.css": "./dist/css/theme-light.css",
    "./themes/dark.css": "./dist/css/theme-dark.css",
    "./themes/deep-dark.css": "./dist/css/theme-deep-dark.css",
    "./themes/corporate-dark.css": "./dist/css/theme-corporate-dark.css",
    "./themes/catppuccin-mocha.css": "./dist/css/theme-catppuccin-mocha.css",
    "./themes/catppuccin-latte.css": "./dist/css/theme-catppuccin-latte.css",
    "./tailwind.css": "./dist/css/tailwind.css",
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "import": "./dist/react-native/index.js"
    },
    "./json": "./dist/json/tokens.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  }
}
